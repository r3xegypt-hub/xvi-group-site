      "errorLight": "rgba(196, 57, 45, 0.1)",
      "warning": "#D4A017",
      "warningLight": "rgba(212, 160, 23, 0.1)",
      "info": "#2563EB",
      "infoLight": "rgba(37, 99, 235, 0.1)"
    }
  },
  "typography": {
    "fontFamily": {
      "headingEn": "'Playfair Display', Georgia, 'Times New Roman', serif",
      "bodyEn": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "headingAr": "'Amiri', 'Traditional Arabic', 'Simplified Arabic', serif",
      "bodyAr": "'Tajawal', 'Arial', 'Helvetica', sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', 'Consolas', monospace"
    },
    "fontSize": {
      "h1": "clamp(2.5rem, 5vw, 3.5rem)",
      "h2": "clamp(2rem, 4vw, 2.625rem)",
      "h3": "clamp(1.5rem, 3vw, 2rem)",
      "h4": "clamp(1.25rem, 2vw, 1.5rem)",
      "body": "clamp(1rem, 1.5vw, 1.125rem)",
      "bodyLarge": "clamp(1.125rem, 1.75vw, 1.25rem)",
      "small": "0.875rem",
      "caption": "0.75rem",
      "eyebrow": "0.8125rem"
    },
    "lineHeight": {
      "h1": "1.15",
      "h2": "1.2",
      "h3": "1.25",
      "h4": "1.33",
      "body": "1.618",
      "bodyAr": "1.75",
      "small": "1.43",
      "caption": "1.33",
      "eyebrow": "1.4"
    },
    "fontWeight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "letterSpacing": {
      "h1": "-0.02em",
      "h2": "-0.01em",
      "h3": "0",
      "h4": "0",
      "body": "0",
      "small": "0.01em",
      "caption": "0.02em",
      "eyebrow": "0.1em"
    }
  },
  "spacing": {
    "2xs": "4px",
    "xs": "8px",
    "sm": "16px",
    "md": "24px",
    "lg": "32px",
    "xl": "48px",
    "2xl": "64px",
    "3xl": "96px",
    "4xl": "128px",
    "5xl": "192px",
    "section": {
      "paddingDesktop": "96px",
      "paddingMobile": "64px",
      "gap": "64px"
    },
    "card": {
      "padding": "24px",
      "gap": "24px"
    },
    "nav": {
      "height": "72px",
      "mobileBarHeight": "64px"
    }
  },
  "borderRadius": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "2xl": "24px",
    "full": "9999px",
    "card": "12px",
    "button": "8px",
    "input": "8px"
  },
  "shadow": {
    "none": "none",
    "xs": "0 1px 2px rgba(10, 22, 40, 0.04)",
    "sm": "0 1px 3px rgba(10, 22, 40, 0.06)",
    "md": "0 4px 12px rgba(10, 22, 40, 0.08)",
    "lg": "0 8px 24px rgba(10, 22, 40, 0.1)",
    "xl": "0 16px 48px rgba(10, 22, 40, 0.12)",
    "card": "0 1px 3px rgba(10, 22, 40, 0.06)",
    "cardHover": "0 8px 24px rgba(10, 22, 40, 0.1)",
    "nav": "0 1px 3px rgba(10, 22, 40, 0.06)",
    "modal": "0 16px 48px rgba(10, 22, 40, 0.12)",
    "goldGlow": "0 0 0 3px rgba(201, 169, 110, 0.15)"
  },
  "glass": {
    "backdrop": "blur(12px) saturate(180%)",
    "background": "rgba(255, 255, 255, 0.85)",
    "border": "1px solid rgba(255, 255, 255, 0.5)"
  },
  "animation": {
    "duration": {
      "fast": "150ms",
      "normal": "200ms",
      "slow": "300ms",
      "slower": "600ms"
    },
    "easing": {
      "default": "cubic-bezier(0.16, 1, 0.3, 1)",
      "inOut": "cubic-bezier(0.45, 0, 0.55, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "scrollReveal": {
      "initial": {
        "opacity": "0",
        "transform": "translateY(20px)"
      },
      "animate": {
        "opacity": "1",
        "transform": "translateY(0)"
      },
      "stagger": "100ms"
    }
  },
  "button": {
    "height": {
      "sm": "40px",
      "md": "48px",
      "lg": "56px"
    },
    "padding": {
      "sm": "0 16px",
      "md": "0 24px",
      "lg": "0 32px"
    },
    "fontSize": {
      "sm": "14px",
      "md": "16px",
      "lg": "18px"
    },
    "variants": {
      "primary": {
        "bg": "#C9A96E",
        "text": "#0A1628",
        "border": "none",
        "hoverBg": "#b8984e",
        "activeBg": "#a8893e"
      },
      "secondary": {
        "bg": "transparent",
        "text": "#0A1628",
        "border": "1px solid #C8CDD5",
        "hoverBg": "rgba(10, 22, 40, 0.04)",
        "activeBg": "rgba(10, 22, 40, 0.08)"
      },
      "ghost": {
        "bg": "transparent",
        "text": "#C9A96E",
        "border": "none",
        "hoverBg": "rgba(201, 169, 110, 0.08)",
        "activeBg": "rgba(201, 169, 110, 0.12)"
      },
      "danger": {
        "bg": "#C4392D",
        "text": "#FFFFFF",
        "border": "none",
        "hoverBg": "#a82e24",
        "activeBg": "#8c251d"
      }
    }
  },
  "grid": {
    "columns": {
      "mobile": 4,
      "tablet": 8,
      "desktop": 12
    },
    "gutter": {
      "mobile": "16px",
      "tablet": "24px",
      "desktop": "32px"
    },
    "margin": {
      "mobile": "16px",
      "tablet": "32px",
      "desktop": "auto"
    },
    "maxWidth": "1200px",
    "narrowWidth": "720px",
    "headerMaxWidth": "640px",
    "descriptionMaxWidth": "560px"
  },
  "breakpoint": {
    "mobile": "640px",
    "tablet": "1024px",
    "desktop": "1440px"
  },
  "zIndex": {
    "base": "0",
    "dropdown": "100",
    "sticky": "200",
    "nav": "300",
    "overlay": "400",
    "modal": "500",
    "toast": "600",
    "loader": "9999"
  }
}
